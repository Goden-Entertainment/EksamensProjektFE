<+><!DOCTYPE html>\r\n<html lang=\"da\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <title>Title</title>\r\n    <link rel=\"stylesheet\" href=\"css/calendar.css\">\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n</head>\r\n<body>\r\n\r\n<!--Calendar-->\r\n<div class=\"calendar\">\r\n    <div class=\"calendar-header\">\r\n        <button id=\"prev-month\">‹</button>\r\n        <div id=\"month-year\"></div>\r\n        <button id=\"next-month\">›</button>\r\n    </div>\r\n    <div class=\"calendar-body\">\r\n        <div class=\"calendar-weekdays\">\r\n            <div>Man</div>\r\n            <div>Tir</div>\r\n            <div>Ons</div>\r\n            <div>Tor</div>\r\n            <div>Fre</div>\r\n            <div>Lør</div>\r\n            <div>Søn</div>\r\n        </div>\r\n        <div class=\"calendar-dates\">\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<!--booking request form-->\r\n<!--note: id on inputs is only needed, if we use js and css. Delete it later if we find out it is not needed.-->\r\n<form action=\"/booking/create\" method=\"post\">\r\n\r\n    <label for=\"companyName\">Virksomhed</label>\r\n    <input type=\"text\" id=\"companyName\" name=\"companyName\" placeholder=\"Navn på virksomhed\" required>\r\n\r\n    <label for=\"address\">Adresse</label>\r\n    <input type=\"text\" id=\"address\" name=\"address\" placeholder=\"Virksomhedens adresse\" required>\r\n\r\n    <label for=\"email\">E-mail</label>\r\n    <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"Eksempel@eksempel.dk\" required>\r\n\r\n    <label for=\"guests\">Antal deltagere</label>\r\n    <input type=\"number\" id=\"guests\" name=\"guests\" min=\"1\" placeholder=\"Forventet antal deltagere\" required>\r\n\r\n    <label for=\"startDate\">Start dato</label>\r\n    <input type=\"date\" id=\"startDate\" name=\"startDate\" required>\r\n\r\n    <label for=\"endDate\">Slut dato</label>\r\n    <input type=\"date\" id=\"endDate\" name=\"endDate\" required>\r\n\r\n    <input type=\"submit\" value=\"Send anmodning\">\r\n</form>\r\n\r\n<script src=\"js/calendar.js\"></script>\r\n</body>\r\n</html>
