+// Find elementerne
+var bookingBtn = document.getElementById('bookingBtn');
+var toastElement = document.getElementById('liveToast');
+
+// Lyt efter klik på booking knappen
+bookingBtn.addEventListener('click', function () {
+    // Valgfrit — opdater teksten dynamisk
+    document.getElementById('toast-title').textContent = 'Booking bekræftet!';
+    document.getElementById('toast-body').textContent = 'Din booking er modtaget. Vi glæder os til at se dig!';
+
+    // Vis toasten
+    var toast = new bootstrap.Toast(toastElement);
+    toast.show();
+});
